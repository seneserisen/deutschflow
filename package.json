{
  "name": "deutschflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "workspaces": ["apps/extension"],
  "scripts": {
    "dev:extension": "npm --workspace apps/extension run dev",
    "build": "npm --workspace apps/extension run build",
    "test:extension": "npm --workspace apps/extension test",
    "typecheck": "npm --workspace apps/extension run typecheck",
    "verify:extension": "npm --workspace apps/extension run verify"
  }
}
